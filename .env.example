# Production settings for docker-compose.yml. Copy to .env (never commit it).

# Public domain pointing at this server (HTTPS certificate is automatic)
DOMAIN=notifications.mon-ecole.cm

# Database password and backup encryption passphrase
POSTGRES_PASSWORD=change-me
BACKUP_PASSPHRASE=change-me-long-passphrase

# 32-byte keys, base64: openssl rand -base64 32
# ENCRYPTION_KEY encrypts parent numbers and Meta secrets (AES-256-GCM).
# PHONE_HASH_KEY keys the searchable phone hash. Back both up: without them the data is unreadable.
ENCRYPTION_KEY=
PHONE_HASH_KEY=

# graph = real WhatsApp Cloud API; mock = simulation (no message leaves the server)
WHATSAPP_PROVIDER=graph
META_GRAPH_VERSION=v23.0
# Optional fallbacks; normally entered in Paramètres → Connexion WhatsApp
META_APP_SECRET=
META_VERIFY_TOKEN=

# First administrator, created on first start by the seed (change the password after login)
SEED_ADMIN_EMAIL=admin@mon-ecole.cm
SEED_ADMIN_PASSWORD=change-me-now
SEED_SAMPLE_DATA=false
