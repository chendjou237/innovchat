# DOMAIN comes from the environment (e.g. notifications.ecole.cm). Caddy obtains and renews
# the HTTPS certificate automatically; plain HTTP is redirected (NFR-13).
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
