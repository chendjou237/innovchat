{
  "name": "innovcare",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:api": "pnpm --filter @innovcare/api dev",
    "dev:worker": "pnpm --filter @innovcare/api dev:worker",
    "dev:web": "pnpm --filter @innovcare/web dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  }
}
