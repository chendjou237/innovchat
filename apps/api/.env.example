# Copy to apps/api/.env for local development.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://innovcare:innovcare@localhost:5433/innovcare
REDIS_URL=redis://localhost:6380
# Public origin of the web app (CORS + cookie)
WEB_ORIGIN=http://localhost:5173
# 32-byte keys, base64 (openssl rand -base64 32)
ENCRYPTION_KEY=change-me-base64-32-bytes
PHONE_HASH_KEY=change-me-base64-32-bytes
# mock | graph
WHATSAPP_PROVIDER=mock
META_GRAPH_VERSION=v23.0
# Used when the Paramètres screen has no value yet
META_APP_SECRET=dev-app-secret
META_VERIFY_TOKEN=dev-verify-token
# Where the mock provider posts its fake status webhooks
MOCK_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/whatsapp
# Initial administrator created by the seed
SEED_ADMIN_EMAIL=admin@ecole.cm
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SAMPLE_DATA=true
